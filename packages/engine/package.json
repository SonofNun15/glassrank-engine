{
  "name": "@glassrank/engine",
  "version": "0.1.0",
  "description": "Pure, deterministic GlassRank rating engine: evidence layer, community rules, and explainable receipts.",
  "license": "Apache-2.0",
  "keywords": [
    "pickleball",
    "rating",
    "elo",
    "glicko"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SonofNun15/glassrank.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/SonofNun15/glassrank#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@glassrank/schema": "workspace:*",
    "@stdlib/math-base-special-exp": "0.2.5",
    "@stdlib/math-base-special-expit": "0.2.4",
    "@stdlib/math-base-special-ln": "0.2.5"
  }
}
