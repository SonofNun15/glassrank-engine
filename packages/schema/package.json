{
  "name": "@glassrank/schema",
  "version": "0.1.0",
  "description": "Versioned data model for GlassRank: types, runtime validators, JSON Schema, canonical JSON, and hashing.",
  "license": "Apache-2.0",
  "keywords": [
    "pickleball",
    "rating",
    "json-schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SonofNun15/glassrank.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/SonofNun15/glassrank#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "json-schema",
    "fixtures"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@date-fns/utc": "2.1.1",
    "@noble/hashes": "2.4.0",
    "date-fns": "4.4.0"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
