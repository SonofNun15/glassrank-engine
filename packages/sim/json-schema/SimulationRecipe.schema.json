              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
              },
              "inflates": {
                "type": "boolean",
                "description": "Reports close losses of a few favored members as wins."
              },
              "olderPool": {
                "type": "boolean"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "verified_host",
                  "provisional_host",
                  "video_verified"
                ],
                "description": "Who vouched for the results. Weighted by `policy.sourceWeights`. Results reported only by players are not accepted: a host or video must vouch for every rated event."
              },
              "weekday": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6,
                "description": "0 = Monday ... 6 = Sunday."
              }
