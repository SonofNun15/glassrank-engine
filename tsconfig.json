{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@glassrank/schema": [
        "./packages/schema/src/index.ts"
      ],
      "@glassrank/engine": [
        "./packages/engine/src/index.ts"
      ],
      "@glassrank/sim": [
        "./packages/sim/src/index.ts"
      ],
      "@glassrank/cli": [
        "./packages/cli/src/index.ts"
      ],
      "@glassrank/design": [
        "./packages/design/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/schema/src",
    "packages/engine/src",
    "packages/sim/src",
    "packages/cli/src",
    "packages/*/tsdown.config.ts",
    "vitest.config.ts"
  ]
}
