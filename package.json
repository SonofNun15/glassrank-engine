{
  "name": "glassrank",
  "private": true,
  "description": "GlassRank: an open, transparent pickleball rating engine.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "generate": "vitest run generated.test --update",
    "sim": "pnpm build && node packages/sim/dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "0.23.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
