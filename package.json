{
  "name": "glassrank",
  "private": true,
  "description": "GlassRank: an open, transparent pickleball rating engine.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "tsc -b && vitest run",
    "test:watch": "vitest",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
